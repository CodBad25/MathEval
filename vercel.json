{
  "version": 2,
  "buildCommand": "echo 'No build needed - static files'",
  "outputDirectory": ".",
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{alea/**,dnb/**,alea.backup/**,test-enrichi/**,dnb-question-extractor/**,backups/**,extension/**,images/**,css/**,js/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/mathalea/:uuid",
      "destination": "/api/mathalea.py"
    },
    {
      "source": "/MathEval/:path*",
      "destination": "/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        }
      ]
    }
  ]
}
